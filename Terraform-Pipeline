pipeline {
    agent any


    stages {
        stage('Checkout') {
            steps {
                git branch: 'SKEL-50-Implementation-Jenkins-configuration-to-AWS', credentialsId: 'jenkins-key', url: 'https://github.com/SkeletonCrew1/SkelBirdView.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh 'terraform plan'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply'
            }
        }
    }
}