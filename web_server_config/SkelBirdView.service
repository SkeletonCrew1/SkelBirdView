[Unit]
Description=Birdwatching
After=network.target

[Service]
User=jenkins
Group=jenkins
WorkingDirectory=/home/jenkins/application/web-servers/
ExecStart=/home/jenkins/application/web-servers/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8000 run:app
Restart=always
StandardOutput=syslog
StandardError=syslog

[Install]
WantedBy=multi-user.target
