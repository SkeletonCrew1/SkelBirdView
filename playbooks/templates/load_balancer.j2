upstream birdwatch {
        server {{ SERVER1 }}:8000;
        server {{ SERVER2 }}:8000;
}

server {
        listen 80 default_server;
        listen [::]:80 default_server;
        listen 443 default_server;
        listen [::]:443 default_server;

        root /var/www/html;
        index index.html index.htm index.nginx-debian.html;
        ssl_certificate     /etc/letsencrypt/live/birdview.pp.ua/fullchain.pem;
        ssl_certificate_key /etc/ssl/private/example.com.privkey.pem;
        server_name _;

        location / {
                proxy_pass http://birdwatch/;
        }


}
