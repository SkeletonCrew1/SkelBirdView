[Unit]
Description=Birdwatching
After=network.target

[Service]
User=vagrant
Group=vagrant
WorkingDirectory=/home/vagrant/application/web-servers/
ExecStart=/home/vagrant/application/web-servers/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 run:app
Restart=always
StandardOutput=syslog
StandardError=syslog
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
